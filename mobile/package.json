{
  "name": "happycash-mobile",
  "private": true,
  "version": "0.1.13",
  "main": "expo/AppEntry.js",
  "description": "App mobile Expo do HappyCash para Android e iOS.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "build:android:apk": "eas build -p android --profile preview",
    "build:android:store": "eas build -p android --profile production",
    "build:ios:store": "eas build -p ios --profile production"
  },
  "dependencies": {
    "expo": "~54.0.34",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "~13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  }
}
