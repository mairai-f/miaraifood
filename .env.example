VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref
# Optional: HappyCash Auth proxy/custom domain used for Google OAuth.
# Leave unset to use the native Supabase auth URL.
# Example: https://app.happycashsite.com.br
# VITE_SUPABASE_AUTH_URL=https://app.happycashsite.com.br
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
VITE_HAPPYCASH_AGENDA_URL=https://agenda.happycashsite.com.br/?site_access=1

# Optional desktop release settings
# DESKTOP_RELEASE_PROVIDER=github
# GITHUB_DESKTOP_RELEASE_OWNER=celioantonio7
# GITHUB_DESKTOP_RELEASE_REPO=HappyCash
# GITHUB_DESKTOP_RELEASE_CHANNEL=latest
# GITHUB_DESKTOP_RELEASE_TOKEN=your-github-token

# Optional Supabase Edge Function rate limiting via Upstash Redis REST.
# Configure these as Supabase secrets, never as VITE_* browser variables.
# UPSTASH_REDIS_REST_URL=https://your-upstash-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# PUBLIC_MENU_RATE_LIMIT_PER_MINUTE=120
# PUBLIC_MENU_ORDER_RATE_LIMIT_PER_MINUTE=30
# PUBLIC_MENU_TABLE_ACTION_RATE_LIMIT_PER_MINUTE=12
# DESKTOP_ACTIVATE_RATE_LIMIT_PER_MINUTE=8

# Supabase Edge Function secrets for NFC-e through Nuvem Fiscal.
# Configure these with `supabase secrets set ...`; do not expose them as VITE_*.
# NUVEM_FISCAL_CLIENT_ID=your-nuvem-fiscal-client-id
# NUVEM_FISCAL_CLIENT_SECRET=your-nuvem-fiscal-client-secret
# NUVEM_FISCAL_TOKEN_SCOPE=empresa nfce
# NUVEM_FISCAL_AUTH_URL=https://auth.nuvemfiscal.com.br/oauth/token
# NUVEM_FISCAL_API_BASE_URL=https://api.sandbox.nuvemfiscal.com.br
