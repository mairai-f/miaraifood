VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref
# Optional MIAR Auth proxy/custom domain used for Google OAuth.
# Leave unset to use the native Supabase auth URL.
# Example: https://app.miaraifood.com.br
# VITE_SUPABASE_AUTH_URL=https://app.miaraifood.com.br
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# Resend: configure RESEND_API_KEY as a Supabase secret for Auth/Edge Functions,
# and in Vercel only for the marketing site's /api/contact route.
# RESEND_API_KEY=re_your_resend_api_key
# MIAR_FROM_EMAIL=MIAR AI/FOOD <no-reply@miaraifood.com.br>
# MIAR_CONTACT_TO=suporte@miaraifood.com.br
# SITE_EMAIL_CONFIRM_REDIRECT_URL=https://www.miaraifood.com.br/auth/callback
# SITE_PASSWORD_RECOVERY_REDIRECT_URL=https://www.miaraifood.com.br/login?recovery=1

# Optional desktop release settings
# DESKTOP_RELEASE_PROVIDER=github
# GITHUB_DESKTOP_RELEASE_OWNER=celioantonio7
# GITHUB_DESKTOP_RELEASE_REPO=MIAR-AI-FOOD-Releases
# GITHUB_DESKTOP_RELEASE_CHANNEL=latest
# GITHUB_DESKTOP_RELEASE_TOKEN=your-github-token

# Optional Supabase Edge Function rate limiting via Upstash Redis REST.
# Configure these as Supabase secrets, never as VITE_* browser variables.
# UPSTASH_REDIS_REST_URL=https://your-upstash-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# PUBLIC_MENU_RATE_LIMIT_PER_MINUTE=120
# PUBLIC_MENU_ORDER_RATE_LIMIT_PER_MINUTE=30
# PUBLIC_MENU_TABLE_ACTION_RATE_LIMIT_PER_MINUTE=12
# DESKTOP_ACTIVATE_RATE_LIMIT_PER_MINUTE=8
# REGISTER_ACCOUNT_RATE_LIMIT_PER_MINUTE=12
# FINALIZE_SITE_REGISTRATION_RATE_LIMIT_PER_MINUTE=20
# CREATE_PLAN_CHARGE_RATE_LIMIT_PER_MINUTE=10
# ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=30
# ADMIN_LOGIN_MAX_FAILED_ATTEMPTS_PER_15_MIN=4
# OPERATOR_LOGIN_RATE_LIMIT_PER_MINUTE=30
# OPERATOR_LOGIN_MAX_IP_ATTEMPTS_PER_15_MIN=3
# OPERATOR_LOGIN_MAX_USERNAME_ATTEMPTS_PER_15_MIN=3
# TRACK_ACCESS_RATE_LIMIT_PER_MINUTE=300
# DESKTOP_LICENSE_RATE_LIMIT_PER_MINUTE=120
# DESKTOP_LICENSE_KEY_RATE_LIMIT_PER_MINUTE=30
# DESKTOP_DOWNLOAD_RATE_LIMIT_PER_MINUTE=20
# MOBILE_DOWNLOAD_RATE_LIMIT_PER_MINUTE=20
# AUTHORIZE_STORE_ADMIN_RATE_LIMIT_PER_MINUTE=30
# AUTHORIZE_PRICING_MANAGER_RATE_LIMIT_PER_MINUTE=30
# MANAGE_OPERATORS_RATE_LIMIT_PER_MINUTE=120
# MANAGE_FISCAL_DOCUMENTS_RATE_LIMIT_PER_MINUTE=120
# SEND_CASH_CLOSE_REPORT_RATE_LIMIT_PER_MINUTE=8
# SEND_AGENDA_REMINDERS_RATE_LIMIT_PER_MINUTE=20

# Supabase Edge Function secrets for NFC-e through Nuvem Fiscal.
# Configure these with `supabase secrets set ...`; do not expose them as VITE_*.
# NUVEM_FISCAL_CLIENT_ID=your-nuvem-fiscal-client-id
# NUVEM_FISCAL_CLIENT_SECRET=your-nuvem-fiscal-client-secret
# NUVEM_FISCAL_TOKEN_SCOPE=empresa nfce
# NUVEM_FISCAL_AUTH_URL=https://auth.nuvemfiscal.com.br/oauth/token
# NUVEM_FISCAL_API_BASE_URL=https://api.sandbox.nuvemfiscal.com.br

# MIAR Gestora IA (Edge Function `miar-assistant`).
# Configure como segredos do Supabase, nunca como VITE_* no navegador:
#   npx supabase@latest secrets set --env-file caminho/do/arquivo-de-chaves.env
# São segredos do servidor; não use VITE_ nem NEXT_PUBLIC_, nem os inclua no executável.
# Cada provedor aceita várias chaves numeradas (até 50), usadas em revezamento;
# a versão sem número continua valendo e entra por último.
# GROQ_API_KEY_1=your-groq-api-key
# GROQ_API_KEY_2=your-other-groq-api-key
# GEMINI_API_KEY_1=your-gemini-api-key
# MISTRAL_API_KEY_1=your-mistral-api-key
# OPENROUTER_API_KEY_1=your-openrouter-api-key
# Modelos são trocáveis sem mexer no código:
# MIAR_AI_GROQ_MODEL=openai/gpt-oss-120b
# MIAR_AI_GEMINI_MODEL=gemini-flash-latest
# MIAR_AI_MISTRAL_MODEL=mistral-small-latest
# MIAR_AI_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Fotos de produto com IA (opcional). Sem nenhum destes, a MIAR não oferece gerar foto.
# As chaves Gemini gratuitas não têm cota de imagem.
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_AI_API_TOKEN=your-workers-ai-api-token
# MIAR_AI_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# MIAR_IMAGE_MONTHLY_LIMIT=30
# MIAR_ASSISTANT_RATE_LIMIT_PER_MINUTE=20
