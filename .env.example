VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref
# Optional: HappyCash Auth proxy/custom domain used for Google OAuth so Google shows a HappyCash domain.
# Example: https://app.happycashsite.com.br
VITE_SUPABASE_AUTH_URL=https://app.happycashsite.com.br
VITE_HAPPYCASH_AGENDA_URL=https://agenda.happycashsite.com.br/?site_access=1

# Optional desktop release settings
# DESKTOP_RELEASE_PROVIDER=github
# GITHUB_DESKTOP_RELEASE_OWNER=celioantonio7
# GITHUB_DESKTOP_RELEASE_REPO=HappyCash
# GITHUB_DESKTOP_RELEASE_CHANNEL=latest
# GITHUB_DESKTOP_RELEASE_TOKEN=your-github-token

# Optional Supabase Edge Function rate limiting via Upstash Redis REST.
# Configure these as Supabase secrets, never as VITE_* browser variables.
# UPSTASH_REDIS_REST_URL=https://your-upstash-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# PUBLIC_MENU_RATE_LIMIT_PER_MINUTE=120
# PUBLIC_MENU_ORDER_RATE_LIMIT_PER_MINUTE=30
# PUBLIC_MENU_TABLE_ACTION_RATE_LIMIT_PER_MINUTE=12
# DESKTOP_ACTIVATE_RATE_LIMIT_PER_MINUTE=8
