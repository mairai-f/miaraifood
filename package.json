{
  "name": "happycash",
  "private": true,
  "version": "0.1.70",
  "description": "HappyCash POS e gestao com desktop comercial e concentrador offline.",
  "author": "Celio Antonio <celioantonio7@users.noreply.github.com>",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "vite --config happycashsite/vite.config.ts",
    "dev:rh": "vite --config happycashrh/vite.config.ts",
    "build": "vite build",
    "build:site": "vite build --config happycashsite/vite.config.ts",
    "build:rh": "vite build --config happycashrh/vite.config.ts",
    "build:all": "npm run build && npm run build:site",
    "mobile:install": "npm install --prefix mobile",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:web": "npm --prefix mobile run web",
    "mobile:build:android:apk": "npm --prefix mobile run build:android:apk",
    "mobile:build:android:store": "npm --prefix mobile run build:android:store",
    "mobile:doctor": "npm --prefix mobile run doctor",
    "demo:create-accounts": "node scripts/create-demo-accounts.mjs",
    "build:dev": "vite build --mode development",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:8080 && cross-env VITE_DEV_SERVER_URL=http://localhost:8080 electron .\"",
    "electron:build": "npm run build && electron-builder --publish never",
    "electron:build:dir": "npm run build && electron-builder --dir",
    "electron:build:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "electron:build:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "electron:build:linux:appimage": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "electron:build:linux:deb": "npm run build && electron-builder --linux deb --x64 --publish never",
    "electron:publish:win": "npm run build && electron-builder --win nsis --x64 --publish always -c.publish.channel=latest -c.publish.releaseType=release",
    "electron:publish:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish always -c.publish.channel=latest -c.publish.releaseType=release",
    "electron:publish:win:beta": "npm run build && electron-builder --win nsis --x64 --publish always -c.publish.channel=beta -c.publish.releaseType=prerelease",
    "electron:publish:linux:beta": "npm run build && electron-builder --linux AppImage deb --x64 --publish always -c.publish.channel=beta -c.publish.releaseType=prerelease",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:site": "vite preview --config happycashsite/vite.config.ts --port 4174",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "security:audit": "node scripts/security-audit.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "electron-updater": "^6.8.3",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router": "^7.14.2",
    "react-router-dom": "^7.14.2",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.6",
    "supabase": "^2.107.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.5"
  },
  "overrides": {
    "js-yaml": "4.1.1"
  },
  "build": {
    "appId": "com.happycash.desktop",
    "productName": "HappyCash",
    "electronUpdaterCompatibility": ">=2.16",
    "generateUpdatesFilesForAllChannels": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "build/icon.ico",
      "electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "celioantonio7",
        "repo": "HappyCash-Releases",
        "channel": "latest",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "HappyCash-Setup-${version}.${ext}",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license.txt",
      "installerHeader": null,
      "installerSidebar": null,
      "uninstallerSidebar": null,
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "include": "build/installer.nsh"
    },
    "linux": {
      "icon": "build/icon.png",
      "artifactName": "HappyCash-${version}.${ext}",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
