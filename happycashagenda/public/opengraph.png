<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0b0b0d"/>
      <stop offset="1" stop-color="#15151a"/>
    </linearGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#d4d4d8"/>
      <stop offset="1" stop-color="#f4f4f5"/>
    </linearGradient>
  </defs>

  <rect width="1200" height="630" fill="url(#bg)"/>
  <circle cx="240" cy="210" r="160" fill="#ffffff" opacity="0.06"/>
  <circle cx="980" cy="460" r="220" fill="#ffffff" opacity="0.05"/>

  <text x="90" y="290" font-family="Georgia, 'Times New Roman', serif" font-size="92" font-weight="700" fill="url(#accent)">BarberPro</text>
  <text x="90" y="365" font-family="Arial, sans-serif" font-size="42" fill="#e4e4e7" opacity="0.9">Agendamento online na barbearia</text>
  <text x="90" y="435" font-family="Arial, sans-serif" font-size="28" fill="#a1a1aa">Escolha serviço, barbeiro e horário em poucos cliques.</text>

  <rect x="90" y="485" width="360" height="10" rx="5" fill="#ffffff" opacity="0.12"/>
  <rect x="90" y="485" width="210" height="10" rx="5" fill="#e4e4e7" opacity="0.9"/>
</svg>
